import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpRequest.BodyPublishers;
import java.net.http.HttpResponse;
import java.net.http.HttpResponse.BodyHandlers;
import java.nio.charset.StandardCharsets;
import java.util.Base64;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * Simple test of GitHub's file system via the REST Contents API.
 * Creates, reads, updates, and deletes a file in a repo.
 * No external dependencies; requires Java 11+.
 *
 * Setup:
 *   export GITHUB_TOKEN="ghp_your_token"   // needs repo / Contents: read & write
 *   export GITHUB_REPO="your-username/your-test-repo"
 *
 * Run (single-file source launch, no compile step):
 *   java GithubFsTest.java
 */
public class GithubFsTest {

    private static final String PATH = "test/hello.txt";
    private static final HttpClient CLIENT = HttpClient.newHttpClient();

    private static String token;
    private static String url;

    public static void main(String[] args) throws Exception {
        token = System.getenv("GITHUB_TOKEN");
        String repo = System.getenv("GITHUB_REPO");
        if (token == null || repo == null) {
            System.err.println("Set GITHUB_TOKEN and GITHUB_REPO first.");
            System.exit(1);
        }
        url = "https://api.github.com/repos/" + repo + "/contents/" + PATH;

        // 1. CREATE
        String body = "{\"message\":\"test: create file\",\"content\":\""
                + b64("Hello, GitHub!") + "\"}";
        check(send("PUT", body), "create file");

        // 2. READ
        String json = check(send("GET", null), "read file");
        String content = new String(
                Base64.getMimeDecoder().decode(
                        extract(json, "content").replace("\\n", "")),
                StandardCharsets.UTF_8);
        if (!content.equals("Hello, GitHub!")) {
            throw new AssertionError("Unexpected content: " + content);
        }
        System.out.println("      content = \"" + content + "\"");
        String sha = extract(json, "sha");

        // 3. UPDATE (requires the current sha)
        body = "{\"message\":\"test: update file\",\"content\":\""
                + b64("Hello again, GitHub!") + "\",\"sha\":\"" + sha + "\"}";
        json = check(send("PUT", body), "update file");
        sha = extract(json, "sha"); // first "sha" in the response is the file's new sha

        // 4. DELETE (requires the latest sha)
        body = "{\"message\":\"test: delete file\",\"sha\":\"" + sha + "\"}";
        check(send("DELETE", body), "delete file");

        System.out.println("\nAll file operations succeeded.");
    }

    private static HttpResponse<String> send(String method, String body) throws Exception {
        HttpRequest.Builder req = HttpRequest.newBuilder(URI.create(url))
                .header("Authorization", "Bearer " + token)
                .header("Accept", "application/vnd.github+json")
                .header("Content-Type", "application/json");
        req.method(method, body == null ? BodyPublishers.noBody() : BodyPublishers.ofString(body));
        return CLIENT.send(req.build(), BodyHandlers.ofString());
    }

    private static String check(HttpResponse<String> resp, String label) {
        int code = resp.statusCode();
        boolean ok = code == 200 || code == 201;
        System.out.println((ok ? "PASS  " : "FAIL  ") + label + " (" + code + ")");
        if (!ok) {
            System.err.println(resp.body());
            System.exit(1);
        }
        return resp.body();
    }

    private static String b64(String text) {
        return Base64.getEncoder().encodeToString(text.getBytes(StandardCharsets.UTF_8));
    }

    /** Minimal JSON string-field extractor, good enough for this test. Use Jackson/Gson in real code. */
    private static String extract(String json, String field) {
        Matcher m = Pattern.compile("\"" + field + "\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"").matcher(json);
        if (!m.find()) {
            throw new IllegalStateException("Field not found: " + field);
        }
        return m.group(1);
    }
}
